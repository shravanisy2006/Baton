# Copy this file to .env (same folder) and fill in the values. Never commit .env.

# Database. Leave empty for a local SQLite file. For Supabase use the "Session pooler" connection string:
# Supabase dashboard -> Connect -> Session pooler -> URI (replace [YOUR-PASSWORD]).
DATABASE_URL=

# Long random string used to sign sessions (e.g. run: python -c "import secrets;print(secrets.token_urlsafe(48))")
APP_SECRET=

# Comma-separated frontend URLs allowed to call the API (Vercel preview URLs are allowed automatically)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional backup model used if the main one fails or hits its limit
BACKUP_AI_PROVIDER=gemini:gemini-3.5-flash-lite

# Optional: store uploaded files in a private Supabase Storage bucket instead of local disk
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sources

# Optional: read-only GitHub token for private repos / higher rate limits
GITHUB_TOKEN=

MAX_UPLOAD_MB=10
