# Copy this file to .env (same folder) and fill in the values. Never commit .env.

# Database. Leave empty for a local SQLite file. For Supabase use the "Session pooler" connection string:
# Supabase dashboard -> Connect -> Session pooler -> URI (replace [YOUR-PASSWORD]).
DATABASE_URL=

# Long random string used to sign sessions (e.g. run: python -c "import secrets;print(secrets.token_urlsafe(48))")
# Required on a real server: the API refuses to start on Render without it.
APP_SECRET=

# Comma-separated website addresses allowed to call the API, exactly (https://..., no trailing /). No wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional backup model used if the main one fails or hits its limit
BACKUP_AI_PROVIDER=gemini:gemini-3.5-flash-lite

# Optional: email through Resend (https://resend.com). Without these, Baton shows invite links to copy and says
# plainly that email isn't set up. EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# The website address, used for links in emails
APP_URL=http://localhost:5173

# Background jobs: worker threads in the API process (1) or a separate `python -m app.worker` (0)
BATON_RUN_WORKER=1
WORKER_THREADS=2
AI_CONCURRENCY=3

# Optional: read-only GitHub token for private repos / higher rate limits
GITHUB_TOKEN=

MAX_UPLOAD_MB=10
MAX_FILES_PER_UPLOAD=10
MAX_SOURCES_PER_PROJECT=200
